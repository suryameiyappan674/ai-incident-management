{
  "info": {
    "name": "AI Incident Management API",
    "_postman_id": "ai-incident-mgmt-v1",
    "description": "Complete API collection for the AI Incident Management system.\n\n**Setup:**\n1. Set the `baseUrl` collection variable if your server runs on a different port.\n2. Run **Login** first — the token is saved automatically to the `token` variable.\n3. All subsequent requests use `{{token}}` via Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "Base URL of the API server"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token — auto-populated after Login"
    },
    {
      "key": "incidentId",
      "value": "INC-0001",
      "type": "string",
      "description": "Human-readable incident ID, e.g. INC-0001"
    },
    {
      "key": "assignmentId",
      "value": "",
      "type": "string",
      "description": "MongoDB ObjectId of an IncidentAssignment document"
    },
    {
      "key": "assigneeUserId",
      "value": "",
      "type": "string",
      "description": "MongoDB ObjectId of the user to assign"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints — login and profile management.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"yourpassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Authenticate with email/username and password. The JWT token is automatically saved to the `token` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Token saved:', json.data.token.substring(0, 30) + '...');",
                  "} else {",
                  "    console.warn('Login response did not contain a token.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Returns the profile of the currently authenticated user."
          },
          "response": []
        },
        {
          "name": "Admin Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/admin-only",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "admin-only"
              ]
            },
            "description": "Restricted to users with the `admin` role."
          },
          "response": []
        },
        {
          "name": "Engineer Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/engineer-only",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "engineer-only"
              ]
            },
            "description": "Restricted to users with the `engineer` or `admin` role."
          },
          "response": []
        },
        {
          "name": "Manage Users Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/manage-users-only",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "manage-users-only"
              ]
            },
            "description": "Restricted to users whose role has the `manage_users` permission."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Incidents",
      "description": "Create, list, and retrieve incidents. All routes require a valid Bearer token.",
      "item": [
        {
          "name": "Create Incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Database connection failure\",\n  \"description\": \"Production DB is throwing timeout errors since 6 PM. Services are degraded.\",\n  \"priority\": \"Critical\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            },
            "description": "Creates a new incident. `createdBy` is set automatically from the JWT token.\n\n**Priority values:** `Low` | `Medium` | `High` | `Critical` (case-sensitive)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.incidentId) {",
                  "    pm.collectionVariables.set('incidentId', json.data.incidentId);",
                  "    console.log('incidentId saved:', json.data.incidentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "Critical",
                  "disabled": true,
                  "description": "Filter by priority: Low | Medium | High | Critical"
                },
                {
                  "key": "status",
                  "value": "Open",
                  "disabled": true,
                  "description": "Filter by status: Open | In Progress | Resolved | Closed"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Results per page (default: 20)"
                }
              ]
            },
            "description": "Returns a paginated list of all incidents. Use query params to filter by `priority` and/or `status`."
          },
          "response": []
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}"
              ]
            },
            "description": "Fetch a single incident along with its assignments.\n\n`:id` accepts either the human-readable `INC-0001` format or a MongoDB ObjectId."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Incident Assignments",
      "description": "Assign users to incidents, list assignees, and remove assignments. All routes require a valid Bearer token.",
      "item": [
        {
          "name": "Assign User to Incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": \"{{assigneeUserId}}\",\n  \"note\": \"First responder for this incident\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/assignments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "assignments"
              ]
            },
            "description": "Assigns a user to an incident. `assignedBy` is set automatically from the JWT token.\n\n- `assigneeId` — MongoDB ObjectId of the user to assign (**required**)\n- `note` — optional context string\n\nReturns `409 Conflict` if the user is already assigned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('assignmentId', json.data._id);",
                  "    console.log('assignmentId saved:', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Assignments for Incident",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/assignments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "assignments"
              ]
            },
            "description": "Returns all users assigned to the specified incident, sorted by assignment date (newest first)."
          },
          "response": []
        },
        {
          "name": "Remove Assignment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/assignments/{{assignmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "assignments",
                "{{assignmentId}}"
              ]
            },
            "description": "Removes a specific assignment from an incident.\n\n- `{{incidentId}}` — `INC-0001` or MongoDB ObjectId\n- `{{assignmentId}}` — MongoDB ObjectId of the IncidentAssignment document (auto-saved after **Assign User to Incident**)"
          },
          "response": []
        }
      ]
    }
  ]
}